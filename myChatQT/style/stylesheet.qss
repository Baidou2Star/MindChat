    border: 1px solid #1d63d6;
    border-radius: 12px;
}

#FriendLabel {
    background: #dcecff;
    border: 1px solid #b8d3fb;
    color: #1f4f87;
    border-radius: 12px;
}

#FriendLabel #tip_lb {
    padding-left: 8px;
