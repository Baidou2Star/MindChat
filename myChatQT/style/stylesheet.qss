    border-radius: 10px;
}

#ApplyFriend #sure_btn[state='hover'],
#AuthenFriend #sure_btn[state='hover'] {
    color: #ffffff;
    background: #2f7de1;
    border-radius: 10px;
}

#ApplyFriend #sure_btn[state='press'],
#AuthenFriend #sure_btn[state='press'] {
    color: #ffffff;
    background: #1654bb;
    border-radius: 10px;
}

#ApplyFriend #cancel_btn[state='normal'],
