/* ===================== 2026 Visual Refresh ===================== */
QWidget {
    font-family: "Segoe UI", "Microsoft YaHei UI";
    color: #1f2a3d;
}

QDialog#LoginDialog,
QDialog#RegisterDialog,
QDialog#ResetDialog {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #f7fbff, stop:1 #eef3f9);
    border: 1px solid #dde6f2;
    border-radius: 14px;
}

#head_widget {
    background: transparent;
}

#head_label {
    border: none;
    background: transparent;
}

#err_tip[state='normal'] {
    color: #1a9d62;
    font-size: 13px;
}

#err_tip[state='err'] {
    color: #d64545;
    font-size: 13px;
}

#tip_lb,
#tip2_lb {
    color: #1a9d62;
    font-size: 13px;
}

#email_lb,
#pass_label,
#user_label,
#confirm_label,
#varify_label,
#user_lb,
#pwd_lb,
#email_label,
#varify_lb {
    color: #40506a;
    font-size: 13px;
    font-weight: 600;
}

#email_edit,
#pass_edit,
#user_edit,
#confirm_edit,
#varify_edit,
#pwd_edit,
#name_ed,
#back_ed,
#lb_ed {
    min-height: 32px;
    border: 1px solid #cfdceb;
    border-radius: 8px;
    background: #ffffff;
    padding: 0 10px;
    selection-background-color: #1f6feb;
    selection-color: #ffffff;
}

#email_edit:focus,
#pass_edit:focus,
#user_edit:focus,
#confirm_edit:focus,
#varify_edit:focus,
#pwd_edit:focus,
#name_ed:focus,
#back_ed:focus,
#lb_ed:focus {
    border: 1px solid #1f6feb;
}

#login_btn,
#reg_btn,
#sure_btn,
#cancel_btn,
#return_btn,
#get_code,
#varify_btn,
#fail_sure_btn {
    min-height: 34px;
    border: none;
    border-radius: 9px;
    font-size: 14px;
    font-weight: 600;
}

#login_btn,
#sure_btn,
#return_btn,
#fail_sure_btn {
    color: #ffffff;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #1f6feb, stop:1 #3590ff);
}

#login_btn:hover,
#sure_btn:hover,
#return_btn:hover,
#fail_sure_btn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #165fd2, stop:1 #2f7de1);
}

#login_btn:pressed,
#sure_btn:pressed,
#return_btn:pressed,
#fail_sure_btn:pressed {
    background: #1654bb;
}

#reg_btn,
#cancel_btn {
    color: #1f6feb;
    background: #e9f1fd;
    border: 1px solid #c7daf7;
}

#reg_btn:hover,
#cancel_btn:hover {
    background: #dceafe;
}

#reg_btn:pressed,
#cancel_btn:pressed {
    background: #cde2ff;
}

#get_code,
#varify_btn {
    color: #1f6feb;
    background: #eaf2ff;
    border: 1px solid #c6d9f8;
}

#get_code:hover,
#varify_btn:hover {
    background: #ddeafe;
}

#get_code:disabled,
#varify_btn:disabled {
    color: #9cadc4;
    background: #f2f5fa;
    border: 1px solid #e2e8f1;
}

#forget_label[state='normal'],
#forget_label[state='selected'] {
    color: #5a6b84;
}

#forget_label[state='hover'],
#forget_label[state='selected_hover'] {
    color: #1f6feb;
}

QDialog#ChatDialog {
    background: #f2f6fb;
    border: 1px solid #d9e2ee;
    border-radius: 12px;
}

#side_bar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #263245, stop:1 #1f2838);
    border-right: 1px solid #33445d;
}

#side_head_lb {
    border-radius: 17px;
    border: 2px solid rgba(255, 255, 255, 0.7);
}

#chat_user_wid {
    background: #f8fbff;
    border-right: 1px solid #dde6f1;
}

#search_wid {
    background: #f8fbff;
    border-bottom: 1px solid #e2eaf4;
}

#search_edit {
    min-height: 32px;
    border: 1px solid #d2deec;
    border-radius: 16px;
    background: #ffffff;
    padding-left: 10px;
    padding-right: 8px;
    color: #1f2a3d;
}

#search_edit:focus {
    border: 1px solid #1f6feb;
}

#chat_user_list,
#search_list,
#con_user_list {
    background: transparent;
    border: none;
    outline: none;
    padding: 4px;
}

#chat_user_list::item,
#search_list::item,
#con_user_list::item {
    border-radius: 8px;
}

#chat_user_list::item:selected,
#search_list::item:selected,
#con_user_list::item:selected {
    background: #dceaff;
}

#chat_user_list::item:hover,
#search_list::item:hover,
#con_user_list::item:hover {
    background: #eaf2fd;
}

#user_name_lb {
    color: #1a2438;
    font-size: 15px;
    font-weight: 600;
}

#user_chat_lb {
    color: #7788a1;
    font-size: 12px;
}

#time_wid #time_lb {
    color: #8898ac;
    font-size: 11px;
}

#title_wid {
    background: #ffffff;
    border-bottom: 1px solid #e2eaf2;
}

#title_lb {
    color: #1f2a3d;
    font-size: 18px;
    font-weight: 700;
}

#chat_data_list {
    background: #f6f9fd;
}

#tool_wid {
    background: #ffffff;
    border-top: 1px solid #e6edf5;
    border-bottom: 1px solid #e6edf5;
}

#chatEdit {
    background: #ffffff;
    color: #1f2a3d;
    border: 1px solid #d9e4f2;
    border-radius: 10px;
    padding: 10px;
    font-size: 14px;
    selection-background-color: #1f6feb;
    selection-color: #ffffff;
}

#chatEdit:focus {
    border: 1px solid #1f6feb;
}

#send_wid {
    background: #ffffff;
    border-top: 1px solid #edf2f7;
}

#send_btn[state='normal'],
#receive_btn[state='normal'] {
    color: #ffffff;
    background: #1f6feb;
    border-radius: 15px;
}

#send_btn[state='hover'],
#receive_btn[state='hover'] {
    background: #2f7de1;
    color: #ffffff;
    border-radius: 15px;
}

#send_btn[state='press'],
#receive_btn[state='press'] {
    background: #1654bb;
    color: #ffffff;
    border-radius: 15px;
}

#ApplyFriend,
#AuthenFriend,
#friend_info_page,
#user_info_page {
    background: #f6f9fd;
}

#friend_apply_wid {
    background: #ffffff;
    border-bottom: 1px solid #e2e9f2;
}

#friend_apply_lb {
    color: #1f2a3d;
    font-size: 17px;
    font-weight: 700;
}

#apply_friend_list {
    background: #f6f9fd;
    border-left: 1px solid #e2e9f2;
}

ApplyFriendItem {
    background: #f6f9fd;
    border-bottom: 1px solid #e2e9f2;
}

ApplyFriendItem #addBtn[state='normal'] {
    background-color: #e9f2ff;
    color: #1f6feb;
    border-radius: 15px;
}

ApplyFriendItem #addBtn[state='hover'] {
    background-color: #dceaff;
    color: #1f6feb;
    border-radius: 15px;
}

ApplyFriendItem #addBtn[state='press'] {
    background-color: #cde1ff;
    color: #1f6feb;
    border-radius: 15px;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #c2cfdf;
    border-radius: 5px;
    min-height: 16px;
}

QScrollBar::handle:vertical:hover {
    background: #aabbd1;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    height: 0px;
    background: transparent;
}

LoadingDlg {
    background: rgba(13, 22, 36, 80);
}

LoadingDlg #status_lb {
    color: #ffffff;
    font-size: 18px;
    font-weight: 600;
}

