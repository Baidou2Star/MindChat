    border: 1px solid #d6e4f7;
    border-radius: 8px;
}

#ApplyFriend #tip_lb,
#AuthenFriend #tip_lb {
    padding-left: 8px;
    color: #315885;
    font-size: 14px;
    font-weight: 600;
}

#ApplyFriend #tipslb[state='normal'],
#AuthenFriend #tipslb[state='normal'] {
    padding: 3px 10px;
    color: #4f607a;
    background: #e9eff7;
