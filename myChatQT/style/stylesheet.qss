}

#ApplyFriend #scrollcontent,
#AuthenFriend #scrollcontent {
    background: transparent;
}

#ApplyFriend #apply_lb,
#AuthenFriend #apply_lb {
    min-height: 60px;
    padding-left: 20px;
    color: #1b3656;
    font-size: 22px;
    font-weight: 700;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #edf4ff, stop:1 #e1ebfa);
    border-bottom: 1px solid #d7e3f3;
}

#ApplyFriend #apply_wid,
#AuthenFriend #apply_wid {
    background: #ffffff;
    border: 1px solid #dbe6f4;
    border-radius: 14px;
    margin: 14px 14px 0 14px;
}

#ApplyFriend #apply_wid QLabel,
#AuthenFriend #apply_wid QLabel {
    color: #38506d;
    font-size: 14px;
    font-weight: 600;
}

#ApplyFriend #name_ed,
#ApplyFriend #back_ed,
#ApplyFriend #lb_ed,
#AuthenFriend #back_ed,
